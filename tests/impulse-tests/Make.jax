#
# Makefile for generating ir using JAX  
#

system := $(shell uname -s)
system := $(shell echo $(system) | grep MINGW > /dev/null && echo MINGW || echo $(system))
ifeq ($(system), MINGW)
 FAUST ?= ../../../build/bin/faust.exe
 COMPARE := ./filesCompare.exe
else
 FAUST ?= ../../../build/bin/faust
 COMPARE := ./filesCompare
endif
MAKE ?= make

GCCOPTIONS := -Ofast -I../../architecture -Iarchs -pthread -std=c++17
outdir ?= jax/double
lang ?= cpp
ext  ?= o
arch ?= impulsejax.py
precision ?=       # filesCompare precision (empty by default)
FAUSTOPTIONS ?= -double

.PHONY: test 

dspfiles := $(wildcard dsp/*.dsp)

# todo: don't ignore bs.dsp and osc_enable.dsp
dspfiles := $(filter-out dsp/bs.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/osc_enable.dsp,$(dspfiles))

# todo: don't ignore bells.dsp (perceptually it sounds the same but is off due to precision issues)
dspfiles := $(filter-out dsp/bells.dsp,$(dspfiles))

# TODO: fix soundfile cache variable handling in JAX backend
# The issue is that cache variables like fSoundfile0ca are referenced without
# the state dictionary prefix after being assigned from state["fSoundfile0"]
dspfiles := $(filter-out dsp/sound.dsp,$(dspfiles))

# ignore noise files because we use jax.random.PRNG instead of a linear congruential generator (LCG) method
dspfiles := $(filter-out $(wildcard dsp/noise*.dsp),$(dspfiles))

# todo: also ignore files which use various noise functions.
dspfiles := $(filter-out dsp/karplus.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/karplus32.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/grain3.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/harpe.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/echo_bug.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/comb_bug_exp.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/table.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/tester.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/tester2.dsp,$(dspfiles))
dspfiles := $(filter-out dsp/reverb_designer.dsp,$(dspfiles))

listfiles = $(dspfiles:dsp/%.dsp=ir/$1/%.ir) 

SRCDIR := tools

#########################################################################
jax: ir/$(outdir) $(call listfiles,$(outdir))

# New target that just runs the Python files without comparison
ifeq ($(DSPS),)
jax-run: ir/$(outdir) $(dspfiles:dsp/%.dsp=ir/$(outdir)/%.run)
else
jax-run: ir/$(outdir) $(DSPS:%.dsp=ir/$(outdir)/%.run)
endif

# New target that runs the Python files with verbose output
ifeq ($(DSPS),)
jax-run-verbose: ir/$(outdir) $(dspfiles:dsp/%.dsp=ir/$(outdir)/%.run-verbose)
else
jax-run-verbose: ir/$(outdir) $(DSPS:%.dsp=ir/$(outdir)/%.run-verbose)
endif

test:
	@echo $(call listfiles,$(outdir))

help:
	@echo "-------- FAUST impulse response tests --------"
	@echo "Available targets are:"
	@echo " 'jax' (default)    : check the double output using the JAX backend"
	@echo " 'jax-run'          : run the JAX backend tests without fileCompare"
	@echo " 'jax-run-verbose'  : run the JAX backend tests with verbose output"
	@echo
	@echo "Options:"
	@echo " 'outdir'       : define the output directory (default to 'jax')"
	@echo " 'FAUSTOPTIONS' : define additional faust options (-double by default)"
	@echo " 'precision'    : define filesCompare expected precision (empty by default)"
	@echo " 'DSPS'         : run specific DSP files (e.g., DSPS=bargraph.dsp)"

#########################################################################
# output directories
ir/$(outdir):
	mkdir -p ir/$(outdir)

#########################################################################
# tools
filesCompare: $(SRCDIR)/filesCompare.cpp
	$(MAKE) filesCompare

#########################################################################
# precision issues

#########################################################################
# rules for JAX

# Keep Python files when using jax-run or jax-run-verbose
.PRECIOUS: ir/$(outdir)/jax_%.py

ir/$(outdir)/jax_%.py: dsp/%.dsp 
	cd $(dir $<); $(FAUST) -lang jax $(notdir $<) -a ../archs/$(arch) $(FAUSTOPTIONS) > ../$@ || (rm -f ../$@; false)

ir/$(outdir)/%.ir: ir/$(outdir)/jax_%.py reference/%.ir
	python3  $< > $@
	$(COMPARE) $@ reference/$(notdir $@) $(precision)

# Rule for running without comparison
ir/$(outdir)/%.run: ir/$(outdir)/jax_%.py
	@echo "Running $(notdir $<)..."
	@python3 $< > /dev/null 2>&1 && echo "✓ $(notdir $<) completed successfully" || echo "✗ $(notdir $<) failed"
	@touch $@

# Rule for running with verbose output (shows errors)
ir/$(outdir)/%.run-verbose: ir/$(outdir)/jax_%.py
	@echo "=== Running $(notdir $<) ==="
	@python3 $< && echo "✓ $(notdir $<) completed successfully" || (echo "✗ $(notdir $<) failed with error:"; exit 1)

#########################################################################
# cleaning
clean:
	rm -f ir/$(outdir)/*.ir ir/$(outdir)/*.py ir/$(outdir)/*.run
